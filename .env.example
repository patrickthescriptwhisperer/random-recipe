# Copy to .env and fill in before production use.
# Never commit .env.

SECRET_KEY=replace-with-a-long-random-string

# false = browse-only (recommended on the public internet)
# true  = anyone who can reach the app can Add/Import recipes
ALLOW_PUBLIC_RECIPE_EDITS=false

# Match these to the host owner of ./data so Add/Import can write recipes.json.
# On Linux: id -u / id -g. Defaults (1000:1000) match the image appuser.
PUID=1000
PGID=1000